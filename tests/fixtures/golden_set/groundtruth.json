  "_instrucciones": {
    "proposito": "Este archivo contiene las etiquetas humanas de referencia (ground truth) para 15 programas seleccionados del corpus. Se usa para medir la precision real del sistema de deteccion tematica y cobertura de perfil.",
    "como_etiquetar": {
      "tematicas": "Para cada programa, abre el Excel y revisa competencias, RA y nucleos tematicos del Paso 5. Marca 'true' si la tematica esta genuinamente presente en el contenido curricular (no solo mencionada de paso), 'false' si no lo esta.",
      "cobertura_perfil": "Revisa el perfil de egreso (Paso 1) y el microcurriculo (Paso 5). Estima visualmente si el currículo cubre el perfil. Rango: 0.0 (nula) a 1.0 (total). Precision: 0.1",
      "umbral_coincidencia_aceptable": "Un resultado se considera correcto si la diferencia entre la estimacion humana y el calculo del sistema es <= 0.15 para cobertura, y coincide en presencia/ausencia para tematicas."
    },
    "quien_etiqueta": "La investigadora principal (Coordinacion Academica). Cada programa debe ser revisado directamente en el archivo Excel, no por inferencia.",
    "fecha_etiquetado": "COMPLETAR"
  },
